{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClient",
    "AccessTokenLifetime": "00:15:00"
  },
  "ServiceBus": {
    "ConnectionString": "",
    "TopicName": "quote-events",
    "NotifySubscriptionName": "notify-sub",
    "AuditSubscriptionName": "audit-sub"
  },
  "Serilog": {
  "MinimumLevel": {
    "Default": "Information",
    "Override": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "QuotesApi": "Information"
    }
  },
  "WriteTo": [
    {
      "Name": "Console",
      "Args": {
        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
      }
    }
  ],
  "Enrich": [
    "FromLogContext"
  ]
}
}