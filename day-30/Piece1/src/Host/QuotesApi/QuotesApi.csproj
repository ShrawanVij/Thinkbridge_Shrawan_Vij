<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b7999b64-84ef-45e1-bb74-cb25cbeab6cb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Host references each module's project — and nothing inside a
         module — never a module's Domain/entities beyond what it maps
         endpoints for. Get this direction wrong (a module referencing
         another module, or referencing Host) and the solution won't build. -->
    <ProjectReference Include="..\..\Contracts\QuotesApi.Contracts\QuotesApi.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Quotes\QuotesApi.Modules.Quotes\QuotesApi.Modules.Quotes.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\QuotesApi.Modules.Identity\QuotesApi.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Collections\QuotesApi.Modules.Collections\QuotesApi.Modules.Collections.csproj" />
    <ProjectReference Include="..\..\Modules\Engagement\QuotesApi.Modules.Engagement\QuotesApi.Modules.Engagement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
