{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "containerAppsEnvironmentResourceId": {
      "value": "${CONTAINER_APPS_ENVIRONMENT_ID}"
    },
    "apiImage": {
      "value": "${API_IMAGE=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "apiMinReplicas": {
      "value": "${API_MIN_REPLICAS=0}"
    },
    "apiMaxReplicas": {
      "value": "${API_MAX_REPLICAS=1}"
    },
    "apiCpu": {
      "value": "${API_CPU=0.25}"
    },
    "apiMemory": {
      "value": "${API_MEMORY=0.5Gi}"
    },
    "sqlSkuName": {
      "value": "${SQL_SKU_NAME=Basic}"
    },
    "sqlSkuTier": {
      "value": "${SQL_SKU_TIER=Basic}"
    },
    "sqlMaxSizeBytes": {
      "value": "${SQL_MAX_SIZE_BYTES=2147483648}"
    },
    "serviceBusSkuName": {
      "value": "${SERVICE_BUS_SKU_NAME=Standard}"
    }
  }
}
